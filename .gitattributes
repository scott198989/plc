* text=auto

*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Controlled source inputs are byte-hashed and must never be normalized.
"References for Codex from Scott/Govs PLC project Research Report.md" -text !eol
*.docx -text

# Pre-remediation audit scratch is immutable byte evidence, including its
# historical line endings and whitespace.
evidence/phase1-closure/pre-remediation/adversarial-scratch/** -text !eol whitespace=-trailing-space,-blank-at-eof

# Binary media must remain byte-preserved when later phases authorize it.
*.gif -text
*.ico -text
*.jpeg -text
*.jpg -text
*.png -text
*.webp -text
